# Backblaze B2 (free tier: 10GB)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=brandframe-demo
B2_REGION=us-west-004
B2_ENDPOINT=s3.us-west-004.backblazeb2.com

# Mistral AI (FREE — no credit card needed. Sign up at https://console.mistral.ai)
MISTRAL_API_KEY=

# Google Gemini API (FREE — for high-quality AI image generation via Nano Banana)
# Sign up: https://aistudio.google.com → "Get API key" (starts with "AIza...")
# Free tier: ~500 image generations/day, no credit card required
GEMINI_API_KEY=

# Inpainting still works without GEMINI_API_KEY — falls back to Pillow compositing

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
