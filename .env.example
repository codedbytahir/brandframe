# Backblaze B2 (free tier: 10GB)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=brandframe-demo
B2_REGION=us-east-005
B2_ENDPOINT=s3.us-east-005.backblazeb2.com

# Mistral AI (FREE — no credit card. Sign up at https://console.mistral.ai)
MISTRAL_API_KEY=

# Google Gemini API (FREE — for AI image generation via Nano Banana / gemini-2.5-flash-image)
# Sign up: https://aistudio.google.com → "Get API key" (starts with "AIza...")
# Free tier: ~500 image generations/day, no credit card
GEMINI_API_KEY=

# Deepgram (FREE — for Speech-to-Text via Nova-3 model)
# Sign up: https://deepgram.com → $200 free credits (~430 hours), NO credit card needed
DEEPGRAM_API_KEY=
# Fallbacks (work without any API keys):
# - Inpainting: Pillow compositing (zero API)
# - No extra keys needed

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
